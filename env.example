# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Firebase (client — safe to expose, prefixed NEXT_PUBLIC_) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase (server / admin SDK — keep secret) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Legacy fallback (only used while Firebase env vars above are unset) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER_TOKEN=

# ── Admin panel (first login bootstraps the admins table, then ignored) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
