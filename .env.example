# ============================================================
# Digital Buy — environment variables
# Add these one by one in Vercel > Project > Settings > Environment Variables.
# Server-only values must never be committed or exposed to the browser.
# ============================================================

# ---------- Core (required) ----------
# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=postgresql://user:password@host:5432/database

# Long random secret used to sign in at /admin. Server-only.
ADMIN_KEY=

# ---------- Payment merchant numbers (public, shown at checkout) ----------
# The numbers customers send bKash / Nagad payments to.
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_NAGAD_NUMBER=01XXXXXXXXX

# ---------- Firebase client config (public, inlined into the browser bundle at build time) ----------
# Firebase console > Project settings > General > Your apps > Web app config.
# If any of these 4 are missing, the login page shows "Sign in is being configured".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: only needed if you later enable FCM / analytics.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---------- Firebase service account (server-only, verifies OTP sign-ins) ----------
# Firebase console > Project settings > Service accounts > Generate new private key (JSON).
# Paste values from that JSON here. Keep the private key on one line with \n for newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Firebase console setup (no env var needed, one-time config) ----------
# 1. Authentication > Sign-in method > enable "Phone".
# 2. Authentication > Settings > Authorized domains > add your production domain
#    (e.g. digitalbuyd.vercel.app and your custom domain) so reCAPTCHA works.
